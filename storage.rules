// ════════════════════════════════════════════════
//  Firebase Storage Rules
//  複製到 Firebase Console → Storage → Rules
// ════════════════════════════════════════════════
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /trips/{tripId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024;  // 最大 5MB
    }
  }
}
